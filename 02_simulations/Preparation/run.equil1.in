# Let the monomers in the sparse system agglomerate

# --- Init ---

include         run.init.in

read_data       system_cell.data

# --- Equilibration SMALL ---

minimize        1.0e-4 1.0e-6 1000 100000

velocity        all create $T ${SEED} dist gaussian

fix             fxnvt all nvt temp $T $T 100

thermo          $(1000/dt)
thermo_style    custom step temp ke pe etotal evdwl ecoul epair ebond eangle edihed press density
dump            1 all custom $(1000/dt) equil1.dump id mol type x y z ix iy iz

run             $(2e6/dt) # 2 ns

unfix           fxnvt

undump          1

write_data      system_equil-small1.data nofix
