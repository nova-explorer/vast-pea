# --- Initialization ---
units           real
boundary        p p p
atom_style      full

# --- PCFF ---
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
kspace_style    pppm 1.0e-4
pair_style      lj/class2/coul/long 12.0
pair_modify     mix sixthpower tail yes

# --- Neighbors ---
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes one 5000 page 100000

# --- Definitions ---
variable        T equal 300 # Temperature used in early equilibration runs and after annealing
variable        Y equal 600 # Temperature used during annealing, curing and replicating
variable        nmax equal 1344 # Total number of curing reactions possible used to calculate conversion level during curing

timestep        0.5
