#-------------------Input_variables-------------------
# dir 1 means x # dir 2 means y # dir 3 means z
variable        dir equal 1

variable        strain equal 0.15
variable        strain_rate_s equal 2e8 # in 1/s
variable        thermo_per_ps equal 5 # N-data points per picosecond for thermo logfile

variable        replicate string 0
variable        system string ber
variable        myid string tensile_${dir}_${system}_replicate_${replicate}


#-------------------Calculated_variables-------------------
timestep        0.5
variable        strain_rate_fs equal ${strain_rate_s}*1e-15 # in 1/fs
variable        totaltime equal ${strain}/${strain_rate_fs} # total time in femtoseconds
variable        steps equal ${totaltime}/dt
variable        eeng equal time*${strain_rate_fs}
variable        etrue equal ln(1+v_eeng)


#-------------------Initialization-------------------
units           real
dimension       3
boundary        p p p
newton          on
atom_style      full


#-------------------Force_field-------------------
label           start
bond_style      class2
angle_style     class2
dihedral_style  class2
improper_style  class2
special_bonds   lj/coul 0 0 1
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes one 5000 page 100000

kspace_style    pppm 1.0e-4
pair_style      lj/class2/coul/long 12.0
pair_modify     mix sixthpower tail yes

read_data       ber_05.data

#-------------------Compute log and restart frequency-------------------
variable         Time equal step/dt/1000 #time in picoseconds
variable         msteps equal 1000/dt/${thermo_per_ps}
variable         nsteps equal 5/dt


#-------------------BER---------------------

molecule        ber_pre  ber_pre.lmpmol
molecule        ber_post ber_post.lmpmol

#-------------------Fixes-------------------
velocity        all create 298 22931 dist gaussian loop local

thermo 1000
thermo_style   custom step temp pe ke etotal press pxx pyy pzz vol density ebond eangle edihed eimp evdwl ecoul elong epair

fix 		1 all npt temp 298 298 $(100/dt) iso 1 1 $(1000/dt)
run 1000000
unfix 1

if "${dir} == 1" then &
  "fix 		rxn all bond/react stabilization yes npt_grp 0.03 react rxn1 all $(10/dt) 0.5 4.12 ber_pre ber_post ber.map stabilize_steps $(500/dt)" &
  "fix          1 npt_grp_REACT npt temp 298 298 $(100/dt) y 1.0 1.0 $(1000/dt) z 1.0 1.0 $(1000/dt)" &
  "fix 		4 bond_react_MASTER_group temp/rescale 1 298 298 1 1" &
  "fix          2 all deform 1 x erate ${strain_rate_fs}"

if "${dir} == 2" then &
  "fix 		rxn all bond/react stabilization yes npt_grp 0.03 react rxn1 all $(10/dt) 0.5 4.12 ber_pre ber_post ber.map stabilize_steps $(500/dt)" &
  "fix          1 npt_grp_REACT npt temp 298 298 $(100/dt) x 1.0 1.0 $(1000/dt) z 1.0 1.0 $(1000/dt)" &
  "fix 		4 bond_react_MASTER_group temp/rescale 1 298 298 1 1" &
  "fix          2 all deform 1 y erate ${strain_rate_fs}"

if "${dir} == 3" then &
  "fix 		rxn all bond/react stabilization yes npt_grp 0.03 react rxn1 all $(10/dt) 0.5 4.12 ber_pre ber_post ber.map stabilize_steps $(500/dt)" &
  "fix          1 npt_grp_REACT npt temp 298 298 $(100/dt) x 1.0 1.0 $(1000/dt) y 1.0 1.0 $(1000/dt)" &
  "fix 		4 bond_react_MASTER_group temp/rescale 1 298 298 1 1" &
  "fix          2 all deform 1 z erate ${strain_rate_fs}"

compute         temperature all temp
variable        w equal 20
variable        pTv equal 0.9
variable        Tv equal 372.3
variable        beta equal v_pTv/(1-v_pTv)
variable        alpha equal v_beta/v_w/2
variable        test equal 1/(exp(-v_alpha*(c_temperature-v_Tv)-ln(v_beta))+1)

group           ber type 14
compute         btype ber property/local btype
compute         batom1 ber property/local batom1
compute         batom2 ber property/local batom2
dump            2 all local $(10/dt) bonds.dump c_btype c_batom1 c_batom2

#-------------------Calculate_strains-------------------
variable        tmp equal lx
variable        lx0 equal ${tmp}
variable        tmp equal ly
variable        ly0 equal ${tmp}
variable        tmp equal lz
variable        lz0 equal ${tmp}
variable        eengx equal (lx-${lx0})/${lx0}
variable        eengy equal (ly-${ly0})/${ly0}
variable        eengz equal (lz-${lz0})/${lz0}
variable        etruex equal ln(1+v_eengx)
variable        etruey equal ln(1+v_eengy)
variable        etruez equal ln(1+v_eengz)


#-------------------Calculate_stresses-------------------
compute        p all pressure 1_temp
variable       sxx equal -0.101325*c_p[1] #in MPa
variable       syy equal -0.101325*c_p[2] #in MPa
variable       szz equal -0.101325*c_p[3] #in MPa
variable       sxy equal -0.101325*c_p[4] #in MPa
variable       sxz equal -0.101325*c_p[5] #in MPa
variable       syz equal -0.101325*c_p[6] #in MPa

fix            sxx_ave all ave/time 1 ${nsteps} ${nsteps} v_sxx
fix            syy_ave all ave/time 1 ${nsteps} ${nsteps} v_syy
fix            szz_ave all ave/time 1 ${nsteps} ${nsteps} v_szz
fix            sxy_ave all ave/time 1 ${nsteps} ${nsteps} v_sxy
fix            sxz_ave all ave/time 1 ${nsteps} ${nsteps} v_sxz
fix            syz_ave all ave/time 1 ${nsteps} ${nsteps} v_syz


#-------------------Outputs-------------------
thermo         $(5/dt)
log            ${myid}.log.lammps
thermo_style   custom step f_rxn[*] v_test temp pe ke etotal press pxx pyy pzz v_etrue v_eengx v_eengy v_eengz v_etruex v_etruey v_etruez &
               f_sxx_ave f_syy_ave f_szz_ave f_sxy_ave f_sxz_ave f_syz_ave lx ly lz v_dir vol density ebond eangle edihed &
               eimp evdwl ecoul elong epair v_Time

dump           6 all atom $(100000/dt) dump.${myid} #every picosecond
dump_modify    6 scale no sort id

#-------------------Run-------------------
run            ${steps}

#-------------------Wrap up-------------------
write_restart  ${myid}.restart
write_data     ${myid}.data
